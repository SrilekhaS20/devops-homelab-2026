pipeline {
    agent any

    tools {
        maven 'Maven-3.9'
    }

    // ✨ NO PARAMETERS! Environment from branch name

    environment {
        APP_NAME = 'java-app'
        DOCKERHUB_USERNAME = 'sri24devops'
        DOCKERHUB_REPO = "${DOCKERHUB_USERNAME}/${APP_NAME}"

        // ✨ CRITICAL: Determine environment from branch name
        ENVIRONMENT = "${env.BRANCH_NAME == 'main' ? 'production' : env.BRANCH_NAME == 'staging' ? 'staging' : 'dev'}"

        // ✨ Port mapping based on environment
        APP_PORT = "${ENVIRONMENT == 'production' ? '8081' : ENVIRONMENT == 'staging' ? '8083' : '8082'}"

        VM_IP = "192.168.1.10"
    }

    stages {
        stage('Show Build Information') {
            steps {
                echo "=========================================="
                echo "🚀 Multibranch Pipeline Build"
                echo "=========================================="
                echo "Git Branch: ${env.BRANCH_NAME}"
                echo "Environment: ${ENVIRONMENT}"
                echo "Port: ${APP_PORT}"
                echo "Build Number: ${BUILD_NUMBER}"
                echo "=========================================="
            }
        }

        stage('Build JAR with Maven') {
            steps {
                echo "📦 Building JAR with Maven..."
                dir('Day-5/java-cicd') {
                    sh '''
                        mvn --version
                        mvn clean package -DskipTests
                        ls -lh target/
                        echo "✅ JAR built successfully!"
                    '''
                }
            }
        }

        stage('Pre-Build Cleanup') {
            steps {
                echo "🧹 Cleaning up old containers before build..."
                sh """
                    docker stop ${APP_NAME}-${ENVIRONMENT} 2>/dev/null || true
                    docker rm ${APP_NAME}-${ENVIRONMENT} 2>/dev/null || true
                    echo "✅ Pre-build cleanup complete!"
                """
            }
        }

        stage('Build and Test in Parallel') {
            parallel {
                stage('Build Docker Image') {
                    steps {
                        echo "🐳 Building Docker image..."
                        dir('Day-5/java-cicd') {
                            sh '''
                                docker build -t ${APP_NAME}:${BUILD_NUMBER} .
                                docker tag ${APP_NAME}:${BUILD_NUMBER} ${DOCKERHUB_REPO}:${BUILD_NUMBER}
                                docker tag ${APP_NAME}:${BUILD_NUMBER} ${DOCKERHUB_REPO}:latest

                                echo "✅ Docker image built!"
                            '''
                        }
                    }
                }

                stage('Run Unit Tests') {
                    steps {
                        echo "🧪 Running unit tests..."
                        dir('Day-5/java-cicd') {
                            sh '''
                                echo "Running Maven tests..."
                                mvn test || true
                                echo "✅ Unit tests completed!"
                            '''
                        }
                    }
                }

                stage('Code Quality Check') {
                    steps {
                        echo "📊 Code quality checks..."
                        dir('Day-5/java-cicd') {
                            sh '''
                                JAVA_FILES=$(find src -name "*.java" | wc -l)
                                echo "Java files: ${JAVA_FILES}"
                                echo "✅ Code quality check passed!"
                            '''
                        }
                    }
                }
            }
        }

        stage('Trivy Security Scan') {
            steps {
                echo "🔒 Running Trivy security scan..."
                sh '''
                    if [ ! -f /var/jenkins_home/tools/trivy ]; then
                        echo "Installing Trivy..."
                        curl -sfL https://raw.githubusercontent.com/aquasecurity/trivy/main/contrib/install.sh | sh -s -- -b /var/jenkins_home/tools
                    fi

                    export PATH=$PATH:/var/jenkins_home/tools
                    timeout 600 trivy image \
                        --exit-code 1 \
                        --severity CRITICAL \
                        --no-progress \
                        ${APP_NAME}:${BUILD_NUMBER}
                    echo "✅ Security scan passed!"
                '''
            }
        }

        stage('Push to Docker Hub') {
            steps {
                echo "📤 Pushing to Docker Hub..."
                script {
                    withCredentials([usernamePassword(
                        credentialsId: 'dockerhub_cred',
                        usernameVariable: 'DOCKER_USER',
                        passwordVariable: 'DOCKER_PASS'
                    )]) {
                        sh '''
                            echo $DOCKER_PASS | docker login -u $DOCKER_USER --password-stdin
                            docker push ${DOCKERHUB_REPO}:${BUILD_NUMBER}
                            docker push ${DOCKERHUB_REPO}:latest
                            docker logout
                            echo "✅ Docker Hub push complete!"
                        '''
                    }
                }
            }
        }

        // ✨ CRITICAL: Production approval only!
        stage('Approval to Deploy') {
            when {
                branch 'main'
            }
            steps {
                echo "⏸️  🚨 WAITING FOR PRODUCTION APPROVAL 🚨"
                timeout(time: 30, unit: 'MINUTES') {
                    input message: "⚠️  Deploy to PRODUCTION? This is the live environment!",
                          ok: 'YES - Deploy to Production'
                }
                echo "✅ Approval granted! Proceeding with production deployment..."
            }
        }

        stage('Cleanup Old Containers') {
            steps {
                echo "🧹 Cleaning up old containers..."
                sh """
                    docker stop ${APP_NAME}-${ENVIRONMENT} 2>/dev/null || true
                    docker rm ${APP_NAME}-${ENVIRONMENT} 2>/dev/null || true
                    echo "✅ Cleanup complete!"
                """
            }
        }

        stage('Deploy Container') {
            steps {
                echo "🚀 Deploying to ${ENVIRONMENT}..."
                sh """
                    echo "Pulling from Docker Hub..."
                    docker pull ${DOCKERHUB_REPO}:${BUILD_NUMBER}

                    echo "Starting container on port ${APP_PORT}..."
                    docker run -d \
                        --name ${APP_NAME}-${ENVIRONMENT} \
                        --restart unless-stopped \
                        -p ${APP_PORT}:8080 \
                        ${DOCKERHUB_REPO}:${BUILD_NUMBER}

                    sleep 30
                    docker ps | grep ${APP_NAME}-${ENVIRONMENT}
                    echo "✅ Deployment successful!"
                """
            }
        }

        stage('Parallel Post-Deployment Tests') {
            parallel {
                stage('Health Checks') {
                    steps {
                        echo "🏥 Running health checks..."
                        sh '''
                            docker exec ${APP_NAME}-${ENVIRONMENT} curl -f http://localhost:8080/api/health || true
                            echo "✅ Health check passed!"
                        '''
                    }
                }

                stage('API Endpoint Tests') {
                    steps {
                        echo "🔌 Testing API endpoints..."
                        sh '''
                            docker exec ${APP_NAME}-${ENVIRONMENT} curl -f http://localhost:8080 || true
                            docker exec ${APP_NAME}-${ENVIRONMENT} curl -f http://localhost:8080/api/hello || true
                            echo "✅ API tests passed!"
                        '''
                    }
                }

                stage('Container Health') {
                    steps {
                        echo "📊 Checking container health..."
                        sh '''
                            docker ps | grep ${APP_NAME}-${ENVIRONMENT}
                            docker stats --no-stream ${APP_NAME}-${ENVIRONMENT} | tail -1 || true
                            echo "✅ Container healthy!"
                        '''
                    }
                }
            }
        }
    }

    post {
        success {
            echo "🎉 =========================================="
            echo "🎉  ${ENVIRONMENT.toUpperCase()} DEPLOYMENT SUCCESS!"
            echo "🎉 =========================================="
            echo "Branch: ${env.BRANCH_NAME}"
            echo "Environment: ${ENVIRONMENT}"
            echo "Port: ${APP_PORT}"
            echo "URL: http://${VM_IP}:${APP_PORT}"
            echo "Docker Hub: ${DOCKERHUB_REPO}:${BUILD_NUMBER}"
            echo "Build Duration: ${currentBuild.durationString}"
            echo "🎉 =========================================="
        }

        failure {
            echo "❌ PIPELINE FAILED on ${ENVIRONMENT}"
            script {
                def previousBuild = env.BUILD_NUMBER.toInteger() - 1
                if (previousBuild > 0) {
                    sh """
                        echo "Attempting rollback to build #${previousBuild}..."
                        docker stop ${APP_NAME}-${ENVIRONMENT} 2>/dev/null || true
                        docker rm ${APP_NAME}-${ENVIRONMENT} 2>/dev/null || true

                        if docker pull ${DOCKERHUB_REPO}:${previousBuild}; then
                            docker run -d \\
                                -p ${APP_PORT}:8080 \\
                                --name ${APP_NAME}-${ENVIRONMENT} \\
                                --restart unless-stopped \\
                                ${DOCKERHUB_REPO}:${previousBuild}
                            echo "✅ Rollback to build #${previousBuild} successful"
                        else
                            echo "❌ Could not find image for rollback"
                        fi
                    """
                }
            }
        }

        always {
            sh 'docker image prune -f || true'
        }
    }
}